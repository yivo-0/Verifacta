<Project>

  <PropertyGroup>
    <!--
      One version for both packages. The release workflow overrides this from the git tag, so a
      published package can always be traced to a commit that exists in the history.
    -->
    <Version>1.0.0</Version>
    <Authors>Oleh Yanytskyi</Authors>
    <Copyright>Copyright (c) 2026 Oleh Yanytskyi</Copyright>
    <PackageProjectUrl>https://github.com/yivo-0/Klarfakt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yivo-0/Klarfakt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- BSL 1.1 has no SPDX expression, so the licence travels as a file. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Shorter than the repository README, which is written for someone deciding whether to
         clone rather than someone looking at a package page. -->
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)package-readme.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
